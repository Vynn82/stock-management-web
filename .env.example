# Frontend Port (local)
PORT=8200

# Backend address, used only by the Next.js proxy (server-side, never sent to the browser).
#   default (no value)  : https://stock.theavin.xyz
#   your own machine   : http://localhost:3000
#   production        : https://stock.theavin.xyz   (set it in Vercel > Environment Variables)
BACKEND_URL=https://stock.theavin.xyz

# Public address of the web app (page metadata / share links). Optional.
NEXT_PUBLIC_SITE_URL=http://localhost:8200
