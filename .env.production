# Production values. On Vercel set the same variables in
# Project > Settings > Environment Variables.

# The NestJS backend (served over HTTPS through Cloudflare). SERVER-SIDE ONLY:
# only the Next.js proxy uses it, the browser talks to this site's /api/backend.
BACKEND_URL=https://stock.theavin.xyz

# Public address of THIS web app (the Vercel domain), e.g. https://app.theavin.xyz.
# Optional: on Vercel it falls back to the project's production URL.
# NEXT_PUBLIC_SITE_URL=
